#: data/org.gnome.desktop.file-sharing.gschema.xml:5
msgid "When to require passwords"
msgstr "Pan rekwirya geryow-tremena"

#: data/org.gnome.desktop.file-sharing.gschema.xml:6
msgid ""
"When to ask for passwords. Possible values are \"never\", \"on_write\", and "
"\"always\"."
msgstr ""
"Pan beji geryow-tremena. Synsas galladow yw \"never\", \"on_write\", hag "
"\"always\"."

#: data/gnome-user-share-webdav.desktop.in.in:2
msgid "File Sharing"
msgstr "Kevrenna Restrennow"

#: data/gnome-user-share-webdav.desktop.in.in:3
msgid "Launch File Sharing if enabled"
msgstr "Lonchya Kevrenna Restrennow mar byw"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/gnome-user-share-webdav.desktop.in.in:5
msgid "share;files;http;network;copy;send;"
msgstr "kevrenna;restrennow;http;rosweyth;kopia;danvon;"

#. Translators: The {} will get filled in with the user name
#. of the user, to form a genitive. If this is difficult to
#. translate correctly so that it will work correctly in your
#. language, you may use something equivalent to
#. "Public files of {}", or leave out the {} altogether.
#: src/http.rs:54
#, rust-format
msgid "{}'s public files"
msgstr "An restrennow poblek {}"

#. Translators: This is similar to the string before, only it
#. has the hostname in it too.
#: src/http.rs:58
#, rust-format
msgid "{0}'s public files on {1}"
msgstr "An restrennow poblek {0} yn {1}"

#~ msgid "Please log in as the user “guest”"
#~ msgstr "Mar pleg omgelmi avel an usyer “guest”"
